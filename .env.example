# Copy to .env (never commit it). Everything below is optional: with no keys, the local
# providers (faster-whisper, Piper, scripted LLM) run the keyless demo.

# LiveKit (dev-mode defaults shown; the keys are the well-known `livekit-server --dev` pair)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
ROUNDTABLE_ROOM=roundtable

# Brain: anthropic | openai (any OpenAI-compatible base URL) | scripted
# ANTHROPIC_API_KEY=
# ROUNDTABLE_LLM=anthropic
# ROUNDTABLE_MODEL=claude-sonnet-5-5
# ROUNDTABLE_OPENAI_BASE_URL=http://localhost:11434/v1

# Speech: local (faster-whisper) | deepgram | openai ; piper | elevenlabs | openai
# A key set for a cloud provider selects it unless the ROUNDTABLE_STT / ROUNDTABLE_TTS variable is set.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=
# ROUNDTABLE_WHISPER_MODEL=base.en
# ROUNDTABLE_PIPER_VOICE=en_US-lessac-medium
